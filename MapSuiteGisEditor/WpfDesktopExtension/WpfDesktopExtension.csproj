<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Keep the original assembly / root namespace so existing pack URIs and editor integrations keep working. -->
    <AssemblyName>ThinkGeo.MapSuite.WpfDesktop.Extension</AssemblyName>
    <RootNamespace>ThinkGeo.MapSuite.WpfDesktop.Extension</RootNamespace>

    <!-- This project already ships an AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ThinkGeo.Core" Version="14.4.3" />
    <PackageReference Include="ThinkGeo.UI.Wpf" Version="14.4.3" />
    <PackageReference Include="ThinkGeo.Printers" Version="14.4.3" />

    <!-- Optional but used by TabFeatureSource and SQL Server helpers. -->
    <PackageReference Include="Microsoft.SqlServer.Types" Version="170.1000.7" />
  </ItemGroup>

  <!-- Legacy WorldMapKit implementation relied on a retired service. The GIS Editor now maps that overlay to OSM. -->
  <ItemGroup>
    <Compile Remove="Layers\FastWorldMapKitRasterLayer.cs" />
  </ItemGroup>

  <!-- Code template files are embedded resources, not compiled source. -->
  <ItemGroup>
    <Compile Remove="DlrLanguages\CodeTemplates\*.cs" />
    <EmbeddedResource Include="DlrLanguages\CodeTemplates\*.cs" />
    <EmbeddedResource Include="DlrLanguages\CodeTemplates\*.py" />
    <EmbeddedResource Include="DlrLanguages\CodeTemplates\*.rb" />
  </ItemGroup>

  <!-- WPF resources -->
  <ItemGroup>
    <Resource Include="Images\**\*.*" />
    <Resource Include="Resources\**\*.*" />
  </ItemGroup>

  <!-- Resx (kept explicit so the designer file stays wired correctly) -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>true</DesignTime>
      <AutoGen>true</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
